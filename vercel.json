{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/hoa-fees-texas-guide",
      "destination": "/blog/hoa-fees-texas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/page/:pageNumber",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

